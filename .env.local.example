# Copia este archivo a .env.local para desarrollo local.
# En Vercel, estas variables se configuran en Settings -> Environment Variables,
# nunca en un archivo commiteado al repo.

# Redis (integracion "Redis" / Upstash de Vercel). Se generan automaticamente
# al anadir la integracion desde el panel de Vercel -> Storage.
# Sin ellas, el formulario de lista de espera (app/descargar/actions.ts)
# responde con un error controlado en vez de persistir el email.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public tracker base URL, including the API prefix. Required for live swarm
# telemetry; do not point production at the local development tracker.
TRACKER_API_URL=

# Opcional. Token de GitHub (solo lectura, sin scopes) para la descarga dinamica
# (lib/release.ts consulta la ultima release del repo del protocolo). Sin token
# funciona igual con el limite anonimo de 60 req/hora; definelo solo si el limite
# por IP compartida de Vercel diera problemas.
GITHUB_TOKEN=
